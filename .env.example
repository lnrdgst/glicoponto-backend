# Copy to .env and replace only the password with your local credential.
SPRING_PROFILES_ACTIVE=local
# Existing database and role names are preserved; legacy GLICOPONTO_DB_* keys also work.
GLICEMIO_DB_URL=jdbc:postgresql://localhost:5432/glicoponto
GLICEMIO_DB_USERNAME=glicoponto_app
GLICEMIO_DB_PASSWORD=replace-with-your-local-password
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWS_ALGORITHM=ES256
